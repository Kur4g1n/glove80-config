/* SPDX-License-Identifier: MIT
 * These behavior implementations are in the personal_glove80 ZMK module.
 */
behaviors {
    il: immediate_layer { compatible = "personal,layer"; #binding-cells = <1>; };
    im: immediate_magic { compatible = "personal,magic"; #binding-cells = <0>; };
    ish: immediate_shift { compatible = "personal,shift"; #binding-cells = <1>; };
    lkset: lkset { compatible = "personal,lock-state"; #binding-cells = <1>; };
    lkcolor: lkcolor { compatible = "personal,lock-color"; #binding-cells = <2>; locked-color = <PALETTE_LAYER_LOCKED>; };
};
macros {
    bt_0: bt_profile_0 {
        compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        wait-ms = <0>; tap-ms = <0>;
        bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
    };
    bt_1: bt_profile_1 {
        compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        wait-ms = <0>; tap-ms = <0>;
        bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
    };
    bt_2: bt_profile_2 {
        compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        wait-ms = <0>; tap-ms = <0>;
        bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
    };
    bt_3: bt_profile_3 {
        compatible = "zmk,behavior-macro"; #binding-cells = <0>;
        wait-ms = <0>; tap-ms = <0>;
        bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
    };
};
